{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "@tstack/cli#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/harness/templates/**"],
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    }
  }
}
