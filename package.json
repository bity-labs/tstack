{
  "name": "tstack",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build && pnpm build:boilerplate",
    "dev": "turbo run dev",
    "install:boilerplate": "pnpm --dir packages/boilerplate install",
    "dev:boilerplate": "pnpm --dir packages/boilerplate dev",
    "dev:mobile": "pnpm --dir packages/boilerplate dev:mobile",
    "build:boilerplate": "pnpm --dir packages/boilerplate build",
    "test:boilerplate": "pnpm --dir packages/boilerplate test",
    "check:boilerplate": "pnpm --dir packages/boilerplate check",
    "generate": "pnpm --dir packages/boilerplate generate",
    "storybook": "pnpm --dir packages/boilerplate storybook",
    "storybook:build": "pnpm --dir packages/boilerplate storybook:build",
    "storybook:mobile": "pnpm --dir packages/boilerplate storybook:mobile",
    "format": "prettier --write . && pnpm --dir packages/boilerplate format",
    "format:check": "prettier --check . && pnpm --dir packages/boilerplate format:check",
    "lint": "turbo run lint && pnpm --dir packages/boilerplate lint",
    "test": "pnpm test:boilerplate",
    "typecheck": "turbo run typecheck && pnpm --dir packages/boilerplate typecheck"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.0",
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
