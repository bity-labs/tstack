<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Welcome to tstack." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Welcome to tstack</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header>
      <a class="wordmark" href="/" aria-label="tstack home">
        tstack
      </a>
    </header>
    <main id="main" tabindex="-1">
      <p class="eyebrow">A new beginning</p>
      <h1>Welcome to tstack.</h1>
      <p>A starting point for what comes next.</p>
      <a class="repository" href="https://github.com/bity-labs/tstack">
        View the repository <span aria-hidden="true">↗</span>
      </a>
    </main>
    <footer>tstack</footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    color-scheme: light;
    font-family: system-ui, sans-serif;
    background: #faf9f6;
    color: #202c27;
  }
  :global(body) {
    min-height: 100svh;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  :global(a) {
    color: inherit;
    text-underline-offset: 0.25em;
  }
  :global(a:focus-visible) {
    outline: 3px solid #246247;
    outline-offset: 6px;
  }
  header,
  footer {
    padding: 1.5rem clamp(1.5rem, 6vw, 6rem);
  }
  header {
    border-bottom: 1px solid #d9ded7;
  }
  .wordmark {
    font-size: 1.25rem;
    font-weight: 750;
    text-decoration: none;
    letter-spacing: -0.05em;
  }
  main {
    flex: 1;
    width: 100%;
    max-width: 76rem;
    margin: auto;
    padding: clamp(4rem, 15vh, 10rem) clamp(1.5rem, 6vw, 6rem);
  }
  .eyebrow {
    color: #456151;
    font-size: 0.875rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 14ch;
    margin: 1.5rem 0;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 550;
    line-height: 1.08;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  main > p:not(.eyebrow) {
    color: #536157;
    font-size: 1.125rem;
    line-height: 1.7;
  }
  .repository {
    display: inline-block;
    margin-top: 1.75rem;
    padding: 0.25rem 0;
    font-weight: 600;
  }
  .repository:hover {
    color: #246247;
  }
  footer {
    color: #536157;
    border-top: 1px solid #d9ded7;
    font-size: 0.875rem;
  }
  .skip-link {
    position: absolute;
    top: 0.75rem;
    left: 1.5rem;
    padding: 0.75rem 1rem;
    background: #fff;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
</style>
