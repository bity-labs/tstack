{
  "$schema": "./products.schema.json",
  "products": [
    // ══════════════════════════════════════════════════════════════
    // SUBSCRIPTION - Fixed Price (Monthly)
    // ══════════════════════════════════════════════════════════════
    {
      "slug": "pro-monthly",           // URL-safe identifier, used in checkout URLs
      "name": "Pro Monthly",           // Display name in Polar dashboard
      "description": "Full access to all features, billed monthly",  // Optional, max 200 chars
      "type": "subscription",          // "subscription" | "one_time" | "free"
      "recurringInterval": "month",    // "day" | "week" | "month" | "year" (required for subscriptions)
      "recurringIntervalCount": 1,     // Optional, default 1. Multiplier for interval (e.g., 3 months)
      "prices": [
        {
          "amountType": "fixed",       // "fixed" | "custom" | "free"
          "amount": 1900,              // Cents. Min 50 ($0.50), max 99999999 ($999,999.99)
          "currency": "usd"            // Only "usd" supported
        }
        // NOTE: price string ($19) and period (/month) are auto-calculated from this
      ],
      "display": {
        "title": "Pro",                // Card title
        "subtitle": "For serious builders",  // Optional subtitle
        "badge": null,                 // Badge text or null (e.g., "Popular", "Best Value")
        "features": [                  // Feature list for pricing card
          "Unlimited projects",
          "Priority support",
          "Advanced analytics"
        ],
        "highlighted": false,          // Whether to highlight this card
        "cta": "Get Started"           // Call-to-action button text
      },
      "polarProductId": null           // Filled automatically after first sync
    },

    // ══════════════════════════════════════════════════════════════
    // SUBSCRIPTION - Fixed Price (Yearly with discount)
    // ══════════════════════════════════════════════════════════════
    {
      "slug": "pro-yearly",
      "name": "Pro Yearly",
      "description": "Full access to all features, billed yearly",
      "type": "subscription",
      "recurringInterval": "year",
      "prices": [
        {
          "amountType": "fixed",
          "amount": 19000,             // $190/year (2 months free vs monthly)
          "currency": "usd"
        }
      ],
      "display": {
        "title": "Pro",
        "subtitle": "For serious builders",
        "badge": "Best Value",         // Show badge for yearly plan
        "features": [
          "Unlimited projects",
          "Priority support",
          "Advanced analytics",
          "2 months free"
        ],
        "highlighted": true,           // Highlight yearly as recommended
        "cta": "Get Started"
      },
      "polarProductId": null
    },

    // ══════════════════════════════════════════════════════════════
    // SUBSCRIPTION - Custom Price (pay-what-you-want)
    // ══════════════════════════════════════════════════════════════
    {
      "slug": "supporter-monthly",
      "name": "Supporter",
      "description": "Support the project with a monthly contribution",
      "type": "subscription",
      "recurringInterval": "month",
      "prices": [
        {
          "amountType": "custom",      // Pay-what-you-want pricing
          "minimumAmount": 500,        // Optional min ($5.00)
          "maximumAmount": 10000,      // Optional max ($100.00)
          "presetAmount": 1000,        // Optional default suggestion ($10.00) - used for display price
          "currency": "usd"
        }
      ],
      "display": {
        "title": "Supporter",
        "subtitle": "Pay what you want",
        "badge": null,
        "features": [
          "Support the project",
          "Early access to features",
          "Community recognition"
        ],
        "highlighted": false,
        "cta": "Support Now"
      },
      "polarProductId": null
    },

    // ══════════════════════════════════════════════════════════════
    // ONE-TIME - Fixed Price
    // ══════════════════════════════════════════════════════════════
    {
      "slug": "lifetime-access",
      "name": "Lifetime Access",
      "description": "One-time payment for forever access",
      "type": "one_time",              // No recurringInterval needed
      "prices": [
        {
          "amountType": "fixed",
          "amount": 29900,             // $299.00
          "currency": "usd"
        }
      ],
      "display": {
        "title": "Lifetime",
        "subtitle": "One-time payment",
        "badge": "Best Deal",
        "features": [
          "Forever access",
          "All future updates",
          "Priority support for life"
        ],
        "highlighted": true,
        "cta": "Buy Now"
      },
      "polarProductId": null
    },

    // ══════════════════════════════════════════════════════════════
    // FREE PRODUCT
    // ══════════════════════════════════════════════════════════════
    {
      "slug": "free-tier",
      "name": "Free Tier",
      "description": "Get started for free",
      "type": "free",                  // No recurringInterval needed
      "prices": [
        {
          "amountType": "free"         // No amount or currency needed
        }
      ],
      "display": {
        "title": "Free",
        "subtitle": "Get started",
        "badge": null,
        "features": [
          "Basic features",
          "Community support",
          "1 project"
        ],
        "highlighted": false,
        "cta": "Start Free"
      },
      "polarProductId": null
    }
  ]
}
