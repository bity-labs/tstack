{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Products Configuration",
  "description": "Polar product definitions for sandbox and production environments",
  "type": "object",
  "required": ["products"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "type", "prices", "display"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 99,
            "description": "Unique kebab-case identifier for the product"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 99,
            "description": "Human-readable product name"
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "description": "Short product description"
          },
          "type": {
            "type": "string",
            "enum": ["subscription", "one_time", "free"],
            "description": "Product type"
          },
          "recurringInterval": {
            "type": "string",
            "enum": ["day", "week", "month", "year"],
            "description": "Billing interval (required for subscription products)"
          },
          "recurringIntervalCount": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of intervals between billings"
          },
          "prices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["amountType"],
              "properties": {
                "amountType": {
                  "type": "string",
                  "enum": ["fixed", "custom", "free"],
                  "description": "Pricing model"
                },
                "amount": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Price in cents"
                },
                "currency": {
                  "type": "string",
                  "enum": ["usd"],
                  "description": "Currency code"
                }
              },
              "additionalProperties": false
            }
          },
          "display": {
            "type": "object",
            "required": ["title", "features", "highlighted", "cta"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Display title for pricing page"
              },
              "subtitle": {
                "type": "string",
                "description": "Subtitle text"
              },
              "badge": {
                "type": ["string", "null"],
                "description": "Badge text (e.g. '2 months free')"
              },
              "features": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Feature list for pricing card"
              },
              "highlighted": {
                "type": "boolean",
                "description": "Whether this product is visually highlighted"
              },
              "cta": {
                "type": "string",
                "minLength": 1,
                "description": "Call-to-action button text"
              }
            },
            "additionalProperties": false
          },
          "polarProductId": {
            "type": ["string", "null"],
            "description": "Polar product ID (null for unconfigured environments)"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
