{
  "name": "@tstack/boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "velite --watch & next dev --turbopack",
    "prebuild": "prisma generate",
    "build": "velite && next build --turbopack",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "velite && tsc --noEmit",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "ngrok": "ngrok http 3000",
    "email:dev": "email dev --port 3001 --dir ./src/components/emails",
    "test": "vitest run --bail 1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.19",
    "@polar-sh/better-auth": "^1.1.9",
    "@polar-sh/sdk": "^0.35.4",
    "@prisma/client": "6.16.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rainbow-me/rainbowkit": "^2.2.8",
    "@react-email/render": "^2.0.9",
    "@tailwindcss/typography": "^0.5.18",
    "@tanstack/react-query": "^5.89.0",
    "@types/mdx": "^2.0.13",
    "better-auth": "^1.3.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "geist": "^1.4.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.544.0",
    "next": "15.5.19",
    "next-safe-action": "^8.0.11",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "posthog-js": "^1.268.8",
    "posthog-node": "^5.9.2",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-hook-form": "^7.63.0",
    "rehype-pretty-code": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.5.2",
    "shiki": "^3.19.0",
    "siwe": "^3.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "velite": "^0.3.1",
    "viem": "^2.37.7",
    "wagmi": "^2.17.1",
    "zod": "^4.1.11"
