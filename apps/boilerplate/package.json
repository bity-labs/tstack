    "@vitejs/plugin-react": "^5.1.2",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "happy-dom": "^20.3.1",
    "prisma": "6.16.2",
    "react-email": "6.6.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5",
    "vitest": "^4.0.17",
    "vitest-mock-extended": "^3.1.0"
  }
