# Project Configuration
PROJECT_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MyApp

# Better Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://myapp:myapp-dev-password@localhost:5432/myapp

# GitHub OAuth (optional - set up on GitHub to enable GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Twitter (X) OAuth (optional - set up on Twitter Developer Portal to enable Twitter login)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# WalletConnect (optional - for wallet connection support)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Landing Mode Configuration (set to "true" to enable landing mode)
LANDING_MODE=false

# Analytics Configuration
# Provider: "umami" (default), "posthog", or "none"
NEXT_PUBLIC_ANALYTICS_PROVIDER=umami

# Umami Configuration (when using umami provider)
# Get your website ID from your Umami dashboard
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_HOST=https://cloud.umami.is

# PostHog Configuration (when using posthog provider)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# File Upload Provider: "database" (default, zero-config) or "digitalocean"
FILE_UPLOAD_PROVIDER=database

# DigitalOcean Spaces Configuration (for file uploads)
# Endpoint should be the region endpoint only (e.g., https://ams3.digitaloceanspaces.com)
# Do NOT include the bucket name in the endpoint
DIGITALOCEAN_SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
DIGITALOCEAN_SPACES_REGION=ams3
DIGITALOCEAN_SPACES_BUCKET=
DIGITALOCEAN_SPACES_ACCESS_KEY_ID=
DIGITALOCEAN_SPACES_SECRET_ACCESS_KEY=
DIGITALOCEAN_SPACES_CDN=
MAX_FILE_SIZE_MB=1

# Polar Configuration (for payments and checkouts)
# Get your access token from Polar Organization Settings
# Use 'sandbox' for testing, 'production' for live payments
POLAR_ACCESS_TOKEN=xxxxx
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=xxxxxx
POLAR_ORGANIZATION_ID=

# Email Configuration (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=no-reply@myapp.example.com
EMAIL_BRAND_LOGO_URL=

# Support Configuration
# Email address for user support (falls back to EMAIL_FROM_ADDRESS)
SUPPORT_EMAIL=support@myapp.example.com