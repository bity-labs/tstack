{
  "name": "@tstack/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Customer-facing TStack repository CLI.",
  "bin": {
    "tstack": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "tsc --project tsconfig.json --noEmit",
