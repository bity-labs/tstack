{
  "name": "@tstack/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "build": "cross-env NODE_ENV=production EXPO_PUBLIC_STORYBOOK_ENABLED=false expo export --platform ios --platform android",
    "lint": "eslint .",
    "typecheck": "pnpm storybook:generate && tsc --noEmit",
    "test": "jest --runInBand",
    "storybook": "cross-env NODE_ENV=development EXPO_PUBLIC_STORYBOOK_ENABLED=true STORYBOOK_DISABLE_TELEMETRY=true expo start --clear",
    "storybook:generate": "sb-rn-get-stories --no-doc-tools"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.27",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tstack/sdk": "workspace:*",
    "better-auth": "1.7.27",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@storybook/addon-ondevice-controls": "10.7.2",
    "@storybook/react-native": "10.7.2",
    "@testing-library/react-native": "14.1.0",
    "@tstack/eslint-config": "workspace:*",
    "@tstack/typescript-config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "cross-env": "10.1.0",
    "eslint": "10.15.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "storybook": "10.6.8",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  }
}
