{
  "name": "@tstack/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "dev": "orval --config orval.config.ts --watch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.2"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@tstack/eslint-config": "workspace:*",
    "@tstack/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "orval": "8.48.0",
    "react": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
