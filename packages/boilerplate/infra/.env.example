# Configure non-secret deployment values in infra/project.ts, not here.
# Export the selected stage and a scoped Cloudflare credential before using Alchemy.
DEPLOY_STAGE=staging
CLOUDFLARE_API_TOKEN=
# Better Auth's deployed secret is managed by Alchemy, not this file or GitHub.
# Local Bun development still requires BETTER_AUTH_SECRET in apps/api/.env.
