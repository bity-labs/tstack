{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "typeRoots": ["../node_modules/@types", "../apps/api/node_modules/@types"]
  },
  "include": ["./**/*.ts", "../alchemy.run.ts"]
}
